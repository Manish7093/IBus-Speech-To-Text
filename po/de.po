#: engine/sttshortcutdialog.ui:114
msgid "Type a new utterance or correct the existing one"
msgstr "Gib eine neue Sprachsequenz ein oder korrigiere die vorhandene"

#: engine/sttshortcutdialog.ui:145
msgid "Speak to add new utterances"
msgstr "Sprich, um neue Sprachsequenzen hinzuzufügen"

#: engine/sttshortcutdialog.ui:235
msgid "Add Utterance"
msgstr "Sprachsequenz hinzufügen"

#: engine/sttshortcutdialog.ui:245 engine/sttshortcutdialog.ui:264
msgid "Apply Changes"
msgstr "Änderungen anwenden"

#: engine/sttshortcutdialog.ui:255
