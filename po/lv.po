msgstr "Runājiet, lai pievienotu jaunas frāzes"

#: engine/sttshortcutdialog.ui:235
msgid "Add Utterance"
msgstr "Pievienot frāzi"

#: engine/sttshortcutdialog.ui:245 engine/sttshortcutdialog.ui:264
msgid "Apply Changes"
